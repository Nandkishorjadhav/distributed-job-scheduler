# ─────────────────────────────────────────────
#  Distributed Job Scheduler — Environment Config
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# Application
NODE_ENV=development

# ─── PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_scheduler
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_scheduler
DB_USER=postgres
DB_PASSWORD=password
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=          # Uncomment if Redis requires a password

# ─── API Service ───────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0

# JWT — change this to a long random secret in production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ─── Scheduler Service ─────────────────────────
SCHEDULER_PORT=3001
# How often the scheduler polls for delayed jobs (ms)
SCHEDULER_POLL_INTERVAL_MS=5000
# How often the scheduler checks cron definitions (ms)
SCHEDULER_CRON_INTERVAL_MS=60000
# Redis lock TTL for leader election (ms)
SCHEDULER_LOCK_TTL_MS=30000
# Redis lock refresh interval (ms)
SCHEDULER_LOCK_REFRESH_MS=10000

# ─── Worker Service ────────────────────────────
WORKER_PORT=3002
# Maximum number of jobs a single worker executes concurrently
WORKER_CONCURRENCY=5
# How often the worker sends a heartbeat to the DB (ms)
WORKER_HEARTBEAT_INTERVAL_MS=10000
# How often the worker polls queues for new jobs (ms)
WORKER_POLL_INTERVAL_MS=1000
# Max time to drain in-flight jobs on SIGTERM (ms)
WORKER_DRAIN_TIMEOUT_MS=30000
# Comma-separated list of queue IDs this worker is subscribed to (empty = all)
WORKER_QUEUE_IDS=

# ─── Stale Job Reaper ──────────────────────────
# Jobs stuck in 'running' for longer than this are re-queued (ms)
STALE_JOB_THRESHOLD_MS=60000

# ─── Frontend ──────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
